# Langfuse credentials - get these from your Langfuse project settings
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM provider — use ONE of the two options below.
# The workshop code talks to the LLM through the OpenAI SDK for both providers.
# For Gemini, the same SDK is pointed at Google's OpenAI-compatible endpoint,
# which is why a Gemini key still goes in OPENAI_API_KEY.

# Option A: OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
APP_MODEL=gpt-4o-mini

# Option B: Google Gemini (https://aistudio.google.com/apikey)
# Comment out Option A above, then uncomment these three lines:
# OPENAI_API_KEY=<your Gemini API key>
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# APP_MODEL=gemini-3.5-flash-lite
